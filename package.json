{
  "name": "bunkai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "icons": "pwa-assets-generator"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ia-writer-mono": "^5.3.0",
    "@fontsource/ia-writer-quattro": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/vollkorn": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "motion": "^14.9.0"
  }
}
